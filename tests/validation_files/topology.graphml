  <key id="d1" for="node" attr.name="type" attr.type="string" />
  <key id="d0" for="node" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="Internet">
      <data key="d0">Internet</data>
      <data key="d1">device</data>
      <data key="d2">Internet</data>
    </node>
