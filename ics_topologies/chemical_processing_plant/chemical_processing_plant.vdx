<?xml version="1.0" encoding="utf-8"?>
<VisioDocument xmlns="http://schemas.microsoft.com/visio/2003/core">
  <DocumentProperties>
    <Title>Chemical Processing Plant</Title>
    <Creator>ICS Topology Generator</Creator>
    <Description>Continuous chemical process (reactor, distillation, storage) operated by a DCS with a dedicated SIL-3 SIS and a Purdue-inspired segmented OT architecture: Enterprise L4, industrial DMZ L3.5, site operations L3, area control L2, field L1 and physical process L0, plus a remote tank farm connected over a leased line + VPN.</Description>
  </DocumentProperties>
