# ICS Risk Assessment Framework - environment configuration
# Copy to .env and adjust for your environment. Never commit .env.

# API server
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# CORS: comma-separated list of allowed origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Optional API-key authentication. Leave empty to disable.
# When set, every /analyze, /settings write and /settings/reset call must
# include "Authorization: Bearer <key>".
ICS_API_KEY=

# Database. SQLite by default; switch to PostgreSQL in production, e.g.
# ICS_DB_URL=postgresql://user:password@host:5432/ics_risk
ICS_DB_URL=sqlite:///backend/data/ICSRiskFramework.db
